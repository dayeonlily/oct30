# 값은 이 파일에 직접 쓰지 말고, .env 로 복사한 뒤 채우세요. (.env 는 .gitignore 에 포함됨)
JEJU_CULTURE_INFO_KEY=
JEJU_CULTURE_LOCATION_KEY=
JEJU_CULTURE_INFO_URL=
JEJU_CULTURE_LOCATION_URL=

# 선택: 장소 그림(Pixabay). 비워 두면 시대별 기본 일러스트를 보여 줍니다.
PIXABAY_API_KEY=
# 선택: 내용 오류 신고 메일. 비워 두면 신고 링크를 숨깁니다.
FEEDBACK_EMAIL=

# PORT=5200
# JEJU_CULTURE_CACHE_MIN=60
# JEJU_CULTURE_KEY_PARAM=serviceKey
